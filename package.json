{
  "name": "property-listing-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "docker:up": "docker run -d -p 27017:27017 --name mongo mongo",
    "docker:down": "docker stop mongo",
    "typecheck": "tsc",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "db:seed": "tsx src/seed.ts"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mongoose": "^9.10.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}